<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.usj.OPD_Management.java.controller.receptionist.treatment.ReceptionistTreatmentBillingController">
    <top>
        <VBox spacing="10.0">
            <children>
                <Label text="Receptionist - Treatment Billing">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Separator />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <TabPane>
            <tabs>
                <Tab closable="false" text="Completed Treatments">
                    <content>
                        <SplitPane dividerPositions="0.6" orientation="VERTICAL">
                            <items>
                                <VBox spacing="10.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="Completed Treatments Ready for Billing">
                                                    <font>
                                                        <Font name="System Bold" size="16.0" />
                                                    </font>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnRefresh" onAction="#btnRefreshOnAction" style="-fx-background-color: #FF9800; -fx-text-fill: white;" text="Refresh" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="tblCompletedTreatments" prefHeight="250.0">
                                            <columns>
                                                <TableColumn fx:id="colTreatmentId" prefWidth="120.0" text="Treatment ID" />
                                                <TableColumn fx:id="colPatientId" prefWidth="100.0" text="Patient ID" />
                                                <TableColumn fx:id="colDoctorId" prefWidth="100.0" text="Doctor ID" />
                                                <TableColumn fx:id="colDescription" prefWidth="200.0" text="Description" />
                                                <TableColumn fx:id="colCompletedDate" prefWidth="140.0" text="Completed Date" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                                <SplitPane dividerPositions="0.4">
                                    <items>
                                        <VBox spacing="15.0">
                                            <children>
                                                <Label text="Add Treatment Cost">
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblSelectedTreatment" text="Select a treatment to add cost" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label text="Cost ($):" />
                                                        <TextField fx:id="txtCost" prefWidth="100.0" promptText="0.00" />
                                                        <Button fx:id="btnAddCost" onAction="#btnAddCostOnAction" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add Cost" />
                                                    </children>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="5.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                        <VBox spacing="10.0">
                                            <children>
                                                <Label text="Treatment Details">
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Label>
                                                <TextArea fx:id="txtTreatmentDetails" editable="false" prefRowCount="8" wrapText="true" />
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                    </items>
                                </SplitPane>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
                <Tab closable="false" text="Billed Treatments">
                    <content>
                        <VBox spacing="10.0">
                            <children>
                                <Label text="Billed Treatments History">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tblBilledTreatments">
                                    <columns>
                                        <TableColumn fx:id="colBilledTreatmentId" prefWidth="120.0" text="Treatment ID" />
                                        <TableColumn fx:id="colBilledPatientId" prefWidth="100.0" text="Patient ID" />
                                        <TableColumn fx:id="colBilledCost" prefWidth="100.0" text="Cost" />
                                        <TableColumn fx:id="colBilledDate" prefWidth="140.0" text="Billed Date" />
                                    </columns>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
